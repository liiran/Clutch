{
  "name": "clutch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 --test-reporter=spec \"tests/e2e/*.e2e.ts\"",
    "bench": "node --experimental-strip-types bench/run.ts",
    "perf": "node --experimental-strip-types tests/e2e/perf.ts",
    "load": "node --experimental-strip-types tests/e2e/load.ts",
    "landing": "node --experimental-strip-types tests/e2e/landing.ts",
    "media": "node --experimental-strip-types bench/media.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
