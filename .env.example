# The chat runs through the Claude Code CLI signed in on this machine, so no API key is needed.
# To use your own Anthropic API key instead, set it here. It stays on the local server and
# each request is billed to it, so set a spend limit in the Claude Console.
ANTHROPIC_API_KEY=

# sonnet, haiku or opus, or a full model name to pin one, such as claude-sonnet-4-6. Haiku is the cheapest.
# With Claude Code these follow the newest version. With an API key they mean the version named in server/anthropic-api.ts.
CLUTCH_CLAUDE_MODEL=sonnet
# low, medium, high, xhigh or max. Higher builds better and takes longer.
CLUTCH_CLAUDE_EFFORT=medium
# Only needed if the claude command cannot be found automatically.
CLUTCH_CLAUDE_BIN=
